"""Raster and vector images."""

type("image", parents = ["bytes"], abstract = True, description = "Raster and vector images")

type("image.arw", parents = ["image"], mime = "image/x-raw", ext = ["arw"], description = "Sony ARW raw image")
type("image.bmp", parents = ["image"], mime = "image/bmp", ext = ["bmp"], description = "Bitmap image")
type("image.bridge-cache", parents = ["image"], mime = "application/octet-stream", ext = ["bct"], description = "Adobe Bridge thumbnail cache image")
type("image.cr2", parents = ["image"], mime = "image/x-canon-cr2", ext = ["cr2"], description = "Canon CR2 raw image")
type("image.crw", parents = ["image"], mime = "image/x-canon-crw", ext = ["crw"], description = "Canon CRW raw image")
type("image.gif", parents = ["image"], mime = "image/gif", ext = ["gif"], description = "GIF image")
type("image.hdr", parents = ["image"], mime = "image/vnd.radiance", ext = ["hdr"], description = "Radiance HDR image")
type("image.heif", parents = ["image"], mime = "image/heif", ext = ["heic", "heif"], description = "HEIF image")
type("image.ico", parents = ["image"], mime = "image/x-icon", ext = ["ico"], description = "Icon image")
type("image.jpeg", parents = ["image"], mime = "image/jpeg", ext = ["jpe", "jpeg", "jpg", "mpo", "thm"], description = "JPEG image")
type("image.jxr", parents = ["image"], mime = "image/vnd.ms-photo", ext = ["jxr"], description = "JPEG XR image")
type("image.mdi", parents = ["image"], mime = "image/vnd.ms-modi", ext = ["mdi"], description = "Microsoft Document Imaging image")
type("image.mrw", parents = ["image"], mime = "image/x-raw", ext = ["mrw"], description = "Minolta raw image")
type("image.png", parents = ["image"], mime = "image/png", ext = ["png"], description = "PNG image")
type("image.psb", parents = ["image"], mime = "application/x-photoshop", ext = ["psb"], description = "Photoshop large document image")
type("image.psd", parents = ["image"], mime = "image/vnd.adobe.photoshop", ext = ["psd"], description = "Photoshop image")
type("image.psp", parents = ["image"], mime = "image/psp", ext = ["psp"], description = "Paint Shop Pro image")
type("image.raf", parents = ["image"], mime = "image/x-raw", ext = ["raf"], description = "Fujifilm raw image")
type("image.svg", parents = ["image", "data.xml"], mime = "image/svg+xml", ext = ["svg"], description = "SVG image")
type("image.tga", parents = ["image"], mime = "image/x-targa", ext = ["tga"], description = "Targa image")
type("image.tiff", parents = ["image"], mime = "image/tiff", ext = ["tif"], description = "TIFF image")
type("image.webp", parents = ["image"], mime = "image/webp", ext = ["webp"], description = "WebP image")
type("image.xcf", parents = ["image"], mime = "image/x-xcf", ext = ["xcf"], description = "GIMP XCF image")
